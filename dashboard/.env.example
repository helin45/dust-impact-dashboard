# Copy this file to .env (same folder as app.py) and fill in real values.
# .env is gitignored -- never commit real credentials.
#
# MERRA-2 validation / wind vectors (Dust source attribution tab).
# Free account: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# SEVIRI Dust RGB scene lookup (Satellite dust imagery panel), optional.
# Free account + API key: https://data.eumetsat.int/ and https://api.eumetsat.int/api-key/
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
